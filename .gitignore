# 비밀키 — 절대 커밋하지 않음
.env
.env (2).example

# 원본 API 응답 캐시 (용량 크고, 재실행하면 다시 만들어짐 — 배포에도 필요 없음)
data/raw/

# data/processed 중 배포된 앱이 실제로 읽는 건 analysis_dataset.parquet 하나뿐이라
# 나머지 중간 산출물은 제외 (필요하면 로컬 파이프라인 재실행으로 다시 만들 수 있음).
# analysis_dataset.parquet 자체는 build_dataset.py에서 쓸모없는 컬럼을 빼고 category/float32로
# 압축해서 100MB 밑으로(현재 ~78MB) 줄여놨기 때문에 Git LFS 없이 그냥 커밋한다
# (Streamlit Community Cloud가 Git LFS를 지원 안 해서 LFS를 쓰면 포인터 텍스트만 받아지는 문제가 있었음).
data/processed/*
!data/processed/analysis_dataset.parquet

# 파이썬 캐시
__pycache__/
*.pyc
.venv/
venv/

# OS/에디터
.DS_Store
.vscode/
